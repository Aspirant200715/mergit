{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mergit.site/spec/v0/phi-result.json",
  "title": "Result of running Φ",
  "type": "object",
  "properties": {
    "exit_code": {
      "type": "integer"
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observed_artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.json#/$defs/hash"
      }
    },
    "stdout_digest": {
      "$ref": "common.json#/$defs/hash"
    },
    "holds": {
      "type": "boolean"
    }
  },
  "required": [
    "exit_code",
    "changed_paths",
    "observed_artifact_hashes",
    "stdout_digest",
    "holds"
  ],
  "additionalProperties": false
}
