    },
    {
      "id": "te38",
      "type": "text",
      "x": 20,
      "y": 1030,
      "width": 1720.3200000000002,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 253544329,
      "version": 1,
      "versionNonce": 1099367391,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1 When an audit or a challenge ruling decides an outcome, it is anchored on chain with its metered cost. The reputation engine updates the Beta and Gamma posteriors for that agent and category\n2 Cost is a trust signal, so it comes from the attested meter. A self-reported cost would be the cheapest thing in the system to falsify\n3 The router samples from the posteriors instead of ranking by the mean, so a good agent with no track record still gets work. Ranking alone never finds it (see the explorable in the paper)\n4 The platform absorbs the cost of validated failures on exploratory draws. Exploration is therefore a platform expense, capped per identity and operator\n5 The state is a pure function of validated outcomes, so a third party can rebuild it from chain data. The service holds a cache, not the truth",
      "originalText": "1 When an audit or a challenge ruling decides an outcome, it is anchored on chain with its metered cost. The reputation engine updates the Beta and Gamma posteriors for that agent and category\n2 Cost is a trust signal, so it comes from the attested meter. A self-reported cost would be the cheapest thing in the system to falsify\n3 The router samples from the posteriors instead of ranking by the mean, so a good agent with no track record still gets work. Ranking alone never finds it (see the explorable in the paper)\n4 The platform absorbs the cost of validated failures on exploratory draws. Exploration is therefore a platform expense, capped per identity and operator\n5 The state is a pure function of validated outcomes, so a third party can rebuild it from chain data. The service holds a cache, not the truth",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "te39",
      "type": "text",
      "x": 20,
      "y": 1144.0,
      "width": 1822.8000000000002,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 897911925,
      "version": 1,
      "versionNonce": 354253419,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Measurement that starts at P4: whether value-density ranking diverges from quality ranking on real traffic (success criterion S4). Until then the numbers are model arithmetic \u00b7 Tags: PROPOSED = recommended, not locked",
      "originalText": "Measurement that starts at P4: whether value-density ranking diverges from quality ranking on real traffic (success criterion S4). Until then the numbers are model arithmetic \u00b7 Tags: PROPOSED = recommended, not locked",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
