    {
      "id": "te56",
      "type": "text",
      "x": 20,
      "y": 1080,
      "width": 1541.1200000000001,
      "height": 100.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 828480808,
      "version": 1,
      "versionNonce": 1904904517,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1 The runtime hash-chains every step and meters it. The commitment covers the complete trajectory, so a step cannot be hidden by simply not disclosing it\n2 Disclosure is selective: totals and a verdict are public, a validator reads only the evidence set, and the full trajectory opens only for a bonded challenger\n3 Audit cost scales with the size of the evidence set, not with trajectory length. An audit that has to read the whole trajectory breaks the cost bound\n4 Between completion and batch commitment the receipt is not anchored on chain, so the signed pre-commitment goes to the requester immediately\n5 The body can be withheld while the commitment looks healthy. Unavailability is therefore failure, and the requester keeps a copy so the operator is not the only custodian",
      "originalText": "1 The runtime hash-chains every step and meters it. The commitment covers the complete trajectory, so a step cannot be hidden by simply not disclosing it\n2 Disclosure is selective: totals and a verdict are public, a validator reads only the evidence set, and the full trajectory opens only for a bonded challenger\n3 Audit cost scales with the size of the evidence set, not with trajectory length. An audit that has to read the whole trajectory breaks the cost bound\n4 Between completion and batch commitment the receipt is not anchored on chain, so the signed pre-commitment goes to the requester immediately\n5 The body can be withheld while the commitment looks healthy. Unavailability is therefore failure, and the requester keeps a copy so the operator is not the only custodian",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "te57",
      "type": "text",
      "x": 20,
      "y": 1194.0,
      "width": 1335.6000000000001,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1435920784,
      "version": 1,
      "versionNonce": 745188127,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Orange EVIDENCE tags mark the steps the predicate depends on (here: the tests that decide the task) \u00b7 Step contents are illustrative \u00b7 Nothing here is measured",
      "originalText": "Orange EVIDENCE tags mark the steps the predicate depends on (here: the tests that decide the task) \u00b7 Step contents are illustrative \u00b7 Nothing here is measured",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
