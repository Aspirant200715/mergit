    },
    {
      "id": "te56",
      "type": "text",
      "x": 20,
      "y": 1014.0,
      "width": 1722.0000000000002,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1506442652,
      "version": 1,
      "versionNonce": 664876774,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Windows run on chain time, not server clocks \u00b7 Two release paths: audited pass releases at once with the window running after; unaudited waits for the window (paper section 10.1) \u00b7 Nothing here is measured",
      "originalText": "Windows run on chain time, not server clocks \u00b7 Two release paths: audited pass releases at once with the window running after; unaudited waits for the window (paper section 10.1) \u00b7 Nothing here is measured",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
