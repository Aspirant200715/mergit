    {
      "id": "te53",
      "type": "text",
      "x": 20,
      "y": 790,
      "width": 616.0000000000001,
      "height": 27.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
