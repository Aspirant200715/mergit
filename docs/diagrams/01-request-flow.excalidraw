    {
      "id": "te63",
      "type": "text",
      "x": 20,
      "y": 872,
      "width": 833.2800000000001,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 964622594,
      "version": 1,
      "versionNonce": 862524476,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1 Requester submits a goal (web app, Slack or a GitHub issue)\n2 API Gateway checks login, tenant and rate limits\n3 Orchestrator asks the Planner to split the goal into tasks, each with a pass/fail check\n4 The requester reviews and approves the plan, so each check is theirs\n5 Orchestrator sends each ready task to the Router\n6 Requester picks the agent (Thompson sampling on success per cost from P4); a worker runs it",
      "originalText": "1 Requester submits a goal (web app, Slack or a GitHub issue)\n2 API Gateway checks login, tenant and rate limits\n3 Orchestrator asks the Planner to split the goal into tasks, each with a pass/fail check\n4 The requester reviews and approves the plan, so each check is theirs\n5 Orchestrator sends each ready task to the Router\n6 Requester picks the agent (Thompson sampling on success per cost from P4); a worker runs it",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "te64",
      "type": "text",
      "x": 995,
      "y": 872,
      "width": 824.32,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1179913225,
      "version": 1,
      "versionNonce": 596654992,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "6a Worker calls the LLM through the Model Gateway (usage is metered)\n6b Worker calls tools; GitHub access goes through the broker, never via prompts\n7 Every call is recorded as a step, hash-chained into one receipt and saved\n8 Validator reads the \u03a6 result the enclave recorded; with probability p it also audits\n9 Verdict goes to the Orchestrator; scores update only on an audit or a ruled challenge\n10 After human approval the PR is opened on GitHub \u00b7 11 live status streams to the requester",
      "originalText": "6a Worker calls the LLM through the Model Gateway (usage is metered)\n6b Worker calls tools; GitHub access goes through the broker, never via prompts\n7 Every call is recorded as a step, hash-chained into one receipt and saved\n8 Validator reads the \u03a6 result the enclave recorded; with probability p it also audits\n9 Verdict goes to the Orchestrator; scores update only on an audit or a ruled challenge\n10 After human approval the PR is opened on GitHub \u00b7 11 live status streams to the requester",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "te65",
      "type": "text",
      "x": 20,
      "y": 1050,
      "width": 1226.4,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1897052333,
      "version": 1,
      "versionNonce": 294046656,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Solid = request path \u00b7 Dashed = approval, storage, live updates \u00b7 Only the Validator can mark a task done; an agent saying 'done' is never trusted",
      "originalText": "Solid = request path \u00b7 Dashed = approval, storage, live updates \u00b7 Only the Validator can mark a task done; an agent saying 'done' is never trusted",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
