    {
      "id": "te40",
      "type": "text",
      "x": 20,
      "y": 1135,
      "width": 1702.4,
      "height": 80.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1050040258,
      "version": 1,
      "versionNonce": 905590325,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1 Receipts are audited at the rate the deterrence rule needs, not at 100 percent. The validator reads only the evidence subset, so audit cost scales with evidence, not with trajectory length\n2 A passing audit releases escrow at once and the window runs after. A failed audit refunds the requester. An undrawn receipt is held until the window expires\n3 Challenge reaches the full trajectory. The bond stops griefing: it is forfeit when the challenge is wrong, and rewarded on top of its return when it is right\n4 The validator interface is the same for the platform's validators now and for outside validators at P5, so decentralizing is a change of who calls it, not a redesign",
      "originalText": "1 Receipts are audited at the rate the deterrence rule needs, not at 100 percent. The validator reads only the evidence subset, so audit cost scales with evidence, not with trajectory length\n2 A passing audit releases escrow at once and the window runs after. A failed audit refunds the requester. An undrawn receipt is held until the window expires\n3 Challenge reaches the full trajectory. The bond stops griefing: it is forfeit when the challenge is wrong, and rewarded on top of its return when it is right\n4 The validator interface is the same for the platform's validators now and for outside validators at P5, so decentralizing is a change of who calls it, not a redesign",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "te41",
      "type": "text",
      "x": 20,
      "y": 1229.0,
      "width": 1268.4,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 84196940,
      "version": 1,
      "versionNonce": 2065920251,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Nothing here is measured: p, q, c_audit and the challenge reward are parameters to be measured from P0 onward \u00b7 Tags: OPEN = undecided (HLD section 11)",
      "originalText": "Nothing here is measured: p, q, c_audit and the challenge reward are parameters to be measured from P0 onward \u00b7 Tags: OPEN = undecided (HLD section 11)",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
