          "type": "text"
        }
      ],
      "updated": 1,
      "link": null,
      "locked": false
    },
    {
      "id": "te37",
      "type": "text",
      "x": 854.8,
      "y": 933.125,
      "width": 470.40000000000003,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 253544329,
      "version": 1,
      "versionNonce": 1099367391,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What it leans on\nq > 0: someone challenges a bad receipt. If nobody does,\nonly audits deter, and the audit rate has to rise.\nThis is the paper's most exposed assumption\nand the mechanism cannot enforce it itself",
      "originalText": "What it leans on\nq > 0: someone challenges a bad receipt. If nobody does,\nonly audits deter, and the audit rate has to rise.\nThis is the paper's most exposed assumption\nand the mechanism cannot enforce it itself",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "assume",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
