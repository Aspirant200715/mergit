    {
      "id": "te38",
      "type": "text",
      "x": 1442.6,
      "y": 933.125,
      "width": 394.8,
      "height": 93.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1625947776,
      "version": 1,
      "versionNonce": 734559256,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Open decisions\nD9 who adjudicates at v1; if the platform does,\nchallenge protects less than it looks\nD14 how challengers are bootstrapped\nD15 who pays for a failed audit",
      "originalText": "Open decisions\nD9 who adjudicates at v1; if the platform does,\nchallenge protects less than it looks\nD14 how challengers are bootstrapped\nD15 who pays for a failed audit",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "open",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "li39",
      "type": "line",
      "x": 20,
      "y": 1115,
      "width": 1880,
      "height": 0,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
