    },
    {
      "id": "te53",
      "type": "text",
      "x": 20,
      "y": 1010,
      "width": 1711.3600000000001,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1018118421,
      "version": 1,
      "versionNonce": 1496886435,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "1 An operator registers an agent in Identity and deposits stake in StakeVault. Stake is what prices an identity, and a contract rather than the control plane enforces it\n2 The requester's payment is locked in Escrow before the task runs, and the agent's stake is encumbered for it. StakeVault enforces the concurrency cap\n3 After the task, the chain gateway commits the receipt root with its attestation reference to ReceiptRegistry, batched across tasks to keep gas down\n4 Audit verdicts and challenge rulings are recorded through ChallengeManager. A successful challenge refunds V, rewards the challenger and slashes stake, in that order\n5 Escrow releases on a passing audit, or when the dispute window expires. Windows run on chain time, and release waits for finality\n6 ReputationAnchor records validated outcomes (audited, or ruled on a challenge) and metered cost, so anyone can rebuild the posteriors. The indexer only reads; settlement never depends on it",
      "originalText": "1 An operator registers an agent in Identity and deposits stake in StakeVault. Stake is what prices an identity, and a contract rather than the control plane enforces it\n2 The requester's payment is locked in Escrow before the task runs, and the agent's stake is encumbered for it. StakeVault enforces the concurrency cap\n3 After the task, the chain gateway commits the receipt root with its attestation reference to ReceiptRegistry, batched across tasks to keep gas down\n4 Audit verdicts and challenge rulings are recorded through ChallengeManager. A successful challenge refunds V, rewards the challenger and slashes stake, in that order\n5 Escrow releases on a passing audit, or when the dispute window expires. Windows run on chain time, and release waits for finality\n6 ReputationAnchor records validated outcomes (audited, or ruled on a challenge) and metered cost, so anyone can rebuild the posteriors. The indexer only reads; settlement never depends on it",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "te54",
      "type": "text",
      "x": 20,
      "y": 1144.0,
      "width": 1982.4,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1426256014,
      "version": 1,
      "versionNonce": 139586394,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Open: D1 which L2, D12 upgradeability, D9 who adjudicates (see diagram 09) \u00b7 The contract holding audit verdicts is fixed in the P3 spec \u00b7 ABIs are generated from the contracts repository, never copied by hand \u00b7 Nothing here is measured",
      "originalText": "Open: D1 which L2, D12 upgradeability, D9 who adjudicates (see diagram 09) \u00b7 The contract holding audit verdicts is fixed in the P3 spec \u00b7 ABIs are generated from the contracts repository, never copied by hand \u00b7 Nothing here is measured",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
